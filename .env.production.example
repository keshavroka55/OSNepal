# Server
PORT=5000
NODE_ENV=production

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_this_min_32_chars
JWT_EXPIRATION=30d

# Database (if using Docker Postgres)
DATABASE_URL=postgresql://User:your_secure_password_here@db:5432/database_name
POSTGRES_PASSWORD=your_secure_password_here


# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# autorized redirect URL
GOOGLE_CALLBACK_URL=https://localhost:8000/api/auth/google/callback

# Email (for password reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password
EMAIL_FROM=noreply@email.com 

# Client URL
CLIENT_URL=https://localhost:3000
