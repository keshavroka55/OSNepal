# Server
PORT=5000
NODE_ENV=production

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_this_min_32_chars
JWT_EXPIRATION=30d

# Database (if using Docker Postgres)
DATABASE_URL=postgresql://User:your_secure_password_here@db:5432/database_name
POSTGRES_PASSWORD=your_secure_password_here

# Or use Managed PostgreSQL
# DATABASE_URL=postgresql://user:pass@managed-db-host:25060/recipenest?sslmode=require

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://recipenest.keshavdev.me/api/auth/google/callback

# Email (for password reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password
EMAIL_FROM=noreply@recipenest.com 

# Client URL
CLIENT_URL=https://recipenest.keshavdev.me
