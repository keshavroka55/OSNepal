# Copy to .env and fill in. The server refuses to start if required values are missing.
NODE_ENV=development
PORT=8000

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/os-nepal

# Auth. Generate with: openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRATION=30d

# Allowed browser origins, comma separated (used for CORS and CSRF origin checks)
CLIENT_URL=http://localhost:3000 

ALLOWED_ORIGINS=https://osnepal.vercel.app,https://osnepal.keshavroka.com.np

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback

# Email (password reset and notifications)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Redis cache. TTLs are in seconds.
REDIS_URL=redis://127.0.0.1:6379
FEED_TTL=10
PROJECT_TTL=15
COMMENT_TTL=10
